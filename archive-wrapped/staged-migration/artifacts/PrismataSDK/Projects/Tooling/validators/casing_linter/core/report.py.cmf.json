  "content": {
    "text": "def generate_report(issues):\n    lines = []\n    lines.append('Casing Audit Report')\n    lines.append('-------------------')\n    lines.append(f'Total issues: {len(issues)}')\n    lines.append('')\n\n    for path, key, casing in issues:\n        lines.append(f'{path}: {key} ? {casing}')\n\n    return '\\\\n'.join(lines)\n",
    "classification": {
      "subtype": "codeblock",
      "rationale": "path_and_filetype_inference"
    }
  }
