  "content": {
    "text": "def generate_report(files):\n    lines = []\n    lines.append('BOM Audit Report')\n    lines.append('----------------')\n    lines.append(f'Files containing BOM: {len(files)}')\n    lines.append('')\n\n    for f in files:\n        lines.append(str(f))\n\n    return '\\\\n'.join(lines)\r\n",
